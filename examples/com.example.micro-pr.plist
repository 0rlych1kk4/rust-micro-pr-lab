<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.example.micro-pr</string>
  <key>WorkingDirectory</key><string>/Users/REPLACE_USERNAME/rust-micro-pr-lab</string>
  <key>ProgramArguments</key>
  <array>
    <string>/Users/REPLACE_USERNAME/rust-micro-pr-lab/target/release/micro-pr</string>
    <string>run</string>
    <string>--execute</string>
    <string>--auto-merge</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/opt/homebrew/bin:/usr/local/bin:/Users/REPLACE_USERNAME/.cargo/bin:/usr/bin:/bin</string></dict>
  <key>StartInterval</key><integer>21600</integer>
  <key>StandardOutPath</key><string>/tmp/micro-pr.log</string>
  <key>StandardErrorPath</key><string>/tmp/micro-pr-error.log</string>
</dict>
</plist>
